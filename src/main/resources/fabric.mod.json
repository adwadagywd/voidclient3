{
  "schemaVersion": 1,
  "id": "voidclient",
  "version": "${version}",
  "name": "VoidClient",
  "description": "Kosmiczny klient: menu pod Y, moduly HUD (FPS, ping, TPS, CPS...), edytor HUD i korekcja kolorow.",
  "authors": ["you"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.voidclient.VoidClientMod"]
  },
  "mixins": [
    { "config": "voidclient.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
